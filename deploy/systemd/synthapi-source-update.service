[Unit]
Description=Build and deploy a verified SynthAPI official-source update
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
UMask=0027
Environment=SYNTHAPI_DIRTY_WORKTREE_POLICY=snapshot
EnvironmentFile=-/etc/synthapi-source-update.env
ExecStart=/home/ubuntu/demo/sub2api/deploy/source-update.sh
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictRealtime=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
